@model UniversityCafeteriaManagement.Models.DatabaseFirst.PurchaseOrder
@{ ViewData["Title"] = "Purchase Order Details"; }
<h1>Purchase Order @Model.Id</h1>
<p><strong>Supplier:</strong> @Model.Supplier.Name</p><p><strong>Date:</strong> @Model.OrderDate.ToLocalTime().ToString("g")</p><p><strong>Status:</strong> @Model.Status</p>
<table class="table"><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@item.Product.Name</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("C")</td><td>@((item.Quantity * item.UnitPrice).ToString("C"))</td></tr> }
</tbody><tfoot><tr><th colspan="3">Total</th><th>@Model.Total.ToString("C")</th></tr></tfoot></table>
@if (Model.Status == "Pending") { <form asp-action="Receive" asp-route-id="@Model.Id" method="post"><button class="btn btn-success" type="submit">Mark received and update inventory</button></form> }
<p><a asp-action="Index">Back to orders</a></p>
