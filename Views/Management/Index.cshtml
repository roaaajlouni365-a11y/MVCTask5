@using UniversityCafeteriaManagement.Models.DatabaseFirst
@{ ViewData["Title"] = "Inventory"; var categories = (IEnumerable<Category>)ViewBag.Categories; var suppliers = (IEnumerable<Supplier>)ViewBag.Suppliers; var products = (IEnumerable<Product>)ViewBag.Products; }
<h1>Inventory</h1>
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<h2>Categories</h2>
<form asp-action="SaveCategory" method="post" class="row g-2 mb-3"><div class="col"><input name="name" class="form-control" placeholder="Category name" required /></div><div class="col"><input name="description" class="form-control" placeholder="Description" /></div><div class="col-auto"><button class="btn btn-primary">Add category</button></div></form>
<table class="table"><thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead><tbody>@foreach (var x in categories) { <tr><td colspan="2"><form asp-action="SaveCategory" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name" class="form-control"/><input name="description" value="@x.Description" class="form-control"/><button class="btn btn-outline-primary">Save</button></form></td><td><form asp-action="DeleteCategory" asp-route-id="@x.Id" method="post"><button class="btn btn-outline-danger">Delete</button></form></td></tr> }</tbody></table>
<h2>Suppliers</h2>
<form asp-action="SaveSupplier" method="post" class="row g-2 mb-3"><div class="col"><input name="name" class="form-control" placeholder="Supplier name" required /></div><div class="col"><input name="email" type="email" class="form-control" placeholder="Email" /></div><div class="col"><input name="phone" class="form-control" placeholder="Phone" /></div><div class="col-auto"><button class="btn btn-primary">Add supplier</button></div></form>
<table class="table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead><tbody>@foreach (var x in suppliers) { <tr><td colspan="3"><form asp-action="SaveSupplier" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name" class="form-control"/><input name="email" value="@x.Email" type="email" class="form-control"/><input name="phone" value="@x.Phone" class="form-control"/><button class="btn btn-outline-primary">Save</button></form></td><td><form asp-action="DeleteSupplier" asp-route-id="@x.Id" method="post"><button class="btn btn-outline-danger">Delete</button></form></td></tr> }</tbody></table>
<h2>Products and stock</h2>
<form asp-action="SaveProduct" method="post" class="row g-2 mb-3"><div class="col"><input name="name" class="form-control" placeholder="Product name" required /></div><div class="col"><input name="price" type="number" min="0" step="0.01" class="form-control" placeholder="Price" required /></div><div class="col"><input name="quantity" type="number" min="0" class="form-control" placeholder="Quantity" required /></div><div class="col"><select name="categoryId" class="form-select" required><option value="">Category</option>@foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }</select></div><div class="col"><select name="supplierId" class="form-select" required><option value="">Supplier</option>@foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }</select></div><div class="col-auto"><button class="btn btn-primary">Add product</button></div></form>
<table class="table"><thead><tr><th>Name</th><th>Price</th><th>Quantity</th><th>Category</th><th>Supplier</th><th>Actions</th></tr></thead><tbody>@foreach (var x in products) { <tr><td colspan="5"><form asp-action="SaveProduct" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@x.Id"/><input name="name" value="@x.Name" class="form-control"/><input name="price" value="@x.Price" type="number" min="0" step="0.01" class="form-control"/><input name="quantity" value="@x.Quantity" type="number" min="0" class="form-control"/><select name="categoryId" class="form-select">@foreach (var c in categories) { <option value="@c.Id" selected="@(c.Id == x.CategoryId)">@c.Name</option> }</select><select name="supplierId" class="form-select">@foreach (var s in suppliers) { <option value="@s.Id" selected="@(s.Id == x.SupplierId)">@s.Name</option> }</select><button class="btn btn-outline-primary">Save</button></form></td><td><form asp-action="DeleteProduct" asp-route-id="@x.Id" method="post"><button class="btn btn-outline-danger">Delete</button></form></td></tr> }</tbody></table>
